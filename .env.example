# SUPABASE_URL: URL de tu proyecto Supabase (ej. https://tuproyecto.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: Clave pública anon / publishable de Supabase
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# SUPABASE_SERVICE_KEY: Opcional (solo si usas service key en lugar de anon key)
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY
